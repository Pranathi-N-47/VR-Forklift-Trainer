theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 14
text = "• Stage 1: Pre-Operation Inspection (4 checkpoints walkaround)
• Stage 2: Mount Forklift Cab (Safe boarding)
• Stage 3: Controls Familiarization (Mast lift and tilt verification)
• Stage 4: Driving Maneuver & Cone Slalom (Rear-wheel pivot steering)
• Stage 5: Cargo Transport Mission (Pickup to 1.2m rack shelf)
• Stage 6: Parking Bay & Shutdown (Neutral gear, forks lowered)
• Stage 7: OSHA Certification & Evaluation (Report card generated)

Scoring: Starting score is 100 points. Passing threshold is 70% or higher.
Penalties: Cone collisions incur a -5 point deduction."

