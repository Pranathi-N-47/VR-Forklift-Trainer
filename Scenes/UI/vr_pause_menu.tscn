theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 14
text = "TRAINING SIMULATOR KEYBINDINGS:

• W / S          : Throttle Forward / Reverse
• A / D          : Rear-Wheel Pivot Steering
• R / F          : Mast Raise / Lower
• T / G          : Mast Tilt Forward / Backward
• E / Spacebar   : Enter / Exit Forklift Cab
• H              : Forklift Safety Horn
• Spacebar       : Hand Brake
• Q / E          : Snap Turn Left / Right (Walking)
• F1             : Toggle On-Screen Helper Card
• Esc / Tab      : Toggle this Settings Menu"

